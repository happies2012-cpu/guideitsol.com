# Production Environment Variables Template
# Copy this file to .env.production and replace all placeholder values with actual production credentials

# Database Configuration
DATABASE_URL="postgresql://username:password@host:port/database_name"

# JWT Configuration - Generate a secure random string at least 32 characters long
JWT_SECRET="your-very-secure-jwt-token-with-at-least-32-characters"

# PayPal Production Configuration
# Obtain from PayPal Business Dashboard
PAYPAL_CLIENT_ID="YOUR_ACTUAL_PAYPAL_PRODUCTION_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_ACTUAL_PAYPAL_PRODUCTION_CLIENT_SECRET"
VITE_PAYPAL_CLIENT_ID_PROD="YOUR_ACTUAL_PAYPAL_PRODUCTION_CLIENT_ID"

# PayU Production Configuration
# Obtain from PayU Merchant Dashboard after KYC verification
PAYU_MERCHANT_KEY="YOUR_ACTUAL_PAYU_PRODUCTION_MERCHANT_KEY"
PAYU_MERCHANT_SALT="YOUR_ACTUAL_PAYU_PRODUCTION_MERCHANT_SALT"
PAYU_AUTH_HEADER="YOUR_ACTUAL_PAYU_AUTH_HEADER_IF_REQUIRED"
VITE_PAYU_MERCHANT_KEY="YOUR_ACTUAL_PAYU_PRODUCTION_MERCHANT_KEY"
VITE_PAYU_PAYMENT_URL="https://secure.payu.in/_payment"

# Razorpay Production Configuration
# Obtain from Razorpay Dashboard
RAZORPAY_KEY_ID="rzp_live_YOUR_ACTUAL_LIVE_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_ACTUAL_LIVE_KEY_SECRET"
VITE_RAZORPAY_KEY_ID_PROD="rzp_live_YOUR_ACTUAL_LIVE_KEY_ID"

# Supabase Configuration (if using Supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_PROJECT_API_KEY"
ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Dashboard Credentials - Change these for security
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="your-secure-admin-password"

# Encryption Keys - Generate secure random strings
SECRET_KEY_BASE="your-production-secret-key-base-for-cookies-at-least-32-characters"
VAULT_ENC_KEY="your-production-encryption-key-exactly-32-characters"

# Server Configuration
PORT=3000
NODE_ENV=production

# HTTPS Configuration
FORCE_HTTPS=true

# CORS Configuration - Replace with your actual domain(s)
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Production URLs - Replace with your actual domain(s)
PRODUCTION_URLS="https://yourdomain.com,https://www.yourdomain.com"

# Frontend URL - Replace with your actual domain
FRONTEND_URL="https://yourdomain.com"

# UPI Configuration - Replace with your business UPI ID
VITE_UPI_ID="your-business-upi@bank"