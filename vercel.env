# ============================================
# GuideIT Solutions - Docker Environment
# ============================================
# Production environment variables for Docker deployment
# Copy this file to .env and update with your actual values

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
PORT=5173
VITE_SITE_URL=http://localhost:5173

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=file:/app/data/database.db

# ============================================
# Security
# ============================================
# IMPORTANT: Change this to a strong random string in production
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION

# ============================================
# Payment Gateway - PayU
# ============================================
PAYU_MERCHANT_KEY=eBVOls
PAYU_MERCHANT_SALT=BHRSfqjp536h47ZXQapuZ2aTpWtR2h5L
PAYU_BASE_URL=https://secure.payu.in/_payment
UPI=8884162999-4@ybl

# ============================================
# Payment Gateway - Razorpay
# ============================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================
# Payment Gateway - PayPal
# ============================================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=live

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@guideitsol.com

# ============================================
# Analytics (Optional)
# ============================================
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Session Configuration
# ============================================
SESSION_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
SESSION_MAX_AGE=86400000

# ============================================
# File Upload Limits
# ============================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log

# ============================================
# Feature Flags
# ============================================
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=false
ENABLE_TWO_FACTOR_AUTH=false

# ============================================
# Admin Configuration
# ============================================
ADMIN_EMAIL=admin@guideitsol.com
ADMIN_PASSWORD=CHANGE_THIS_IN_PRODUCTION
