{
  "name": "Guidesoft Website",
  "description": "Guidesoft IT Solutions Website",
  "deploy": {
    "type": "static",
    "buildCommand": "npm run build:prod",
    "outputDirectory": "dist",
    "port": 80
  },
  "healthcheck": {
    "path": "/",
    "port": 80
  },
  "env": {
    "NODE_ENV": "production"
  },
  "domains": [
    {
      "host": "guideitsol.com",
      "port": 80,
      "https": true
    },
    {
      "host": "www.guideitsol.com",
      "port": 80,
      "https": true
    }
  ]
}