# Database Configuration
DATABASE_URL="file:./prod.db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-token-with-at-least-32-characters-long"

# PayPal Configuration
PAYPAL_CLIENT_ID="your-production-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-production-paypal-client-secret"

# PayU Configuration
PAYU_MERCHANT_KEY="your-production-payu-merchant-key"
PAYU_MERCHANT_SALT="your-production-payu-merchant-salt"
PAYU_AUTH_HEADER="your-production-payu-auth-header"

# Frontend PayU Key (Vite environment variable)
VITE_PAYU_MERCHANT_KEY="your-production-payu-merchant-key-for-frontend"

# Supabase Configuration
SUPABASE_URL="your-production-supabase-url"
SUPABASE_KEY="your-production-supabase-anon-key"
ANON_KEY="your-production-supabase-anon-key"
SERVICE_ROLE_KEY="your-production-supabase-service-role-key"

# Dashboard Credentials
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="your-secure-dashboard-password"

# Encryption Keys
SECRET_KEY_BASE="your-production-secret-key-base-for-cookies"
VAULT_ENC_KEY="your-production-encryption-key-32-chars-min"

# Server Configuration
PORT=3000
NODE_ENV=production

# HTTPS Configuration
FORCE_HTTPS=true

# CORS Configuration
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Production URLs
PRODUCTION_URLS="https://yourdomain.com,https://www.yourdomain.com"