# ============================================
# Docker Ignore File
# ============================================
# Prevents unnecessary files from being copied into Docker image

# Node modules (will be installed in container)
node_modules
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# Development files
.git
.gitignore
.github
.vscode
.idea
*.swp
*.swo
*~

# Environment files (use .env.docker instead)
.env
.env.local
.env.development
.env.test
.env.production.local

# Build outputs (will be built in container)
dist
build
.next
out

# Test files
coverage
.nyc_output
test
tests
**/__tests__
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts

# Documentation
*.md
!README.md
docs
documentation

# Deployment files
cpanel-deployment
WEBSITE-READY-FOR-DEPLOYMENT
backups
*.zip
*.tar.gz
*.tgz

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode
.idea
*.sublime-project
*.sublime-workspace

# Temporary files
tmp
temp
*.tmp
*.temp

# Database files (will be created in volume)
*.db
*.db-journal
*.sqlite
*.sqlite3
data/*.db

# Cache
.cache
.parcel-cache
.eslintcache

# Misc
*.pem
*.key
*.cert
*.crt

# Docker files (already in use)
Dockerfile
.dockerignore
docker-compose*.yml

# Scripts not needed in production
scripts/build-*.js
scripts/deploy-*.js
scripts/test-*.js
scripts/generate-*.js

# Marketing assets
marketing_assets

# Electron (not needed for web deployment)
electron
electron-builder.config.js

# Vercel
.vercel

# Coolify/Dokploy configs (handled separately)
coolify.json
dokploy.json
Caddyfile
nginx.conf

# Backup files
BACKUP_LOCATION.txt
commit_demo.txt
test.txt
test-db.js

# Deployment guides
DEPLOYMENT_*.md
GITHUB_*.md
PAYMENT_*.md
PRODUCTION_*.md
QA_*.md
SEO_*.md
SECURITY_*.md
TASK_*.md
TODO.md
TEST_USERS.md
PROJECT_SCAN_SUMMARY.md

# Cyberduck profiles
*.cyberduckprofile

# Untitled files
Untitled.*
